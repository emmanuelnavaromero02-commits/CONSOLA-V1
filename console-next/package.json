{
  "name": "console-next",
  "version": "0.1.0",
  "private": true,
  "description": "OMEGA console static export served by FastAPI.",
  "scripts": {
    "dev": "next dev --port 8001",
    "build": "next build",
    "export:copy": "npm run build && rm -rf ../console/app/static/console-next && cp -R out ../console/app/static/console-next && rm -rf ../console/app/static/console-next/studio && find ../console/app/static/console-next -type f -exec perl -pi -e 's/[ \\t]+$//' {} +",
    "verify:static": "npm run export:copy && git diff --exit-code -- ../console/app/static/console-next",
    "start": "python3 -m http.server 8001 -d out",
    "typecheck": "rm -rf .next && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.all=true --coverage.include='src/**/*.{ts,tsx}' --coverage.exclude='src/**/*.test.{ts,tsx}' --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=json-summary"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.453.0",
    "next": "16.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.76.0",
    "react-textarea-autosize": "^8.5.9",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "brace-expansion": "file:vendor/brace-expansion-compat",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^29.1.1",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "$brace-expansion",
    "postcss": "8.5.23",
    "sharp": "0.35.4"
  }
}

{
  "displayName": "hubspot_ingest_bi_all",
  "trigger": {
    "name": "trigger",
    "displayName": "Webhook — recibe mode + run_id",
    "type": "PIECE_TRIGGER",
    "settings": {
      "pieceName": "@activepieces/piece-webhook",
      "triggerName": "catch_webhook",
      "input": { "authType": "none" },
      "inputUiInfo": {}
    },
    "nextAction": {
      "name": "log_start",
      "displayName": "Log inicio",
      "type": "PIECE",
      "settings": {
        "pieceName": "@activepieces/piece-http",
        "actionName": "send_request",
        "input": {
          "method": "POST",
          "url": "http://console:8000/n8n/log",
          "headers": {},
          "queryParams": {},
          "body": {
            "type": "json",
            "data": {
              "run_id":       "{{ trigger.body.run_id }}",
              "workflow":     "hubspot_ingest_bi_all",
              "cartridge_id": "hubspot",
              "entity":       "ALL",
              "level":        "INFO",
              "status":       "started",
              "message":      "{{ 'Iniciando ' + trigger.body.mode + ' para todas las entidades' }}"
            }
          },
          "failsafe": true,
          "timeout": 10
        }
      },
      "nextAction": {
        "name": "extract_all",
        "displayName": "Extraer todas desde el cartucho",
        "type": "PIECE",
        "settings": {
          "pieceName": "@activepieces/piece-http",
          "actionName": "send_request",
          "input": {
            "method": "POST",
            "url": "{{ 'http://hubspot:8210/skills/run_' + trigger.body.mode + '_all' }}",
            "headers": {},
            "queryParams": {},
            "body": { "type": "none" },
            "failsafe": true,
            "timeout": 1200
          }
        },
        "nextAction": {
          "name": "log_done",
          "displayName": "Log completado",
          "type": "PIECE",
          "settings": {
            "pieceName": "@activepieces/piece-http",
            "actionName": "send_request",
            "input": {
              "method": "POST",
              "url": "http://console:8000/n8n/log",
              "headers": {},
              "queryParams": {},
              "body": {
                "type": "json",
                "data": {
                  "run_id":       "{{ trigger.body.run_id }}",
                  "workflow":     "hubspot_ingest_bi_all",
                  "cartridge_id": "hubspot",
                  "entity":       "ALL",
                  "level":        "{{ extract_all.body.error ? 'ERROR' : 'INFO' }}",
                  "status":       "{{ extract_all.body.error ? 'failed' : 'completed' }}",
                  "message":      "{{ extract_all.body.error ? ('Error: ' + extract_all.body.error) : 'Ingesta de todas las entidades completada' }}",
                  "detail":       "{{ extract_all.body }}"
                }
              },
              "failsafe": true,
              "timeout": 10
            }
          }
        }
      }
    }
  }
}


[agent]
tenant_id = "<TENANT_ID>"          # (OMEGA_TENANT_ID)
workspace_id = "<WORKSPACE_ID>"    # (OMEGA_WORKSPACE_ID)

state_dir = 'C:\ProgramData\OmegaSapB1Agent'   # (OMEGA_AGENT_STATE_DIR)

entities = []
exclude = []

max_pending_files = 500

[source]
dialect = "hana"                    # (SAP_B1_DIALECT) hana | postgres (banco de pruebas)
host = "<HANA_HOST>"                # (SAP_B1_HOST)
port = 30015                        # (SAP_B1_PORT) puerto SQL del tenant
user = "<READ_ONLY_USER>"           # (SAP_B1_USER)
password = "<HANA_PASSWORD>"        # (SAP_B1_PASSWORD)
database = ""                       # (SAP_B1_DATABASE) tenant al entrar por SYSTEMDB; vacio si el puerto ya es del tenant
companies = "empresa_a=<SCHEMA_A>,empresa_b=<SCHEMA_B>"   # (SAP_B1_COMPANIES)
intercompany = "empresa_a:<CODIGO_SN_EMPRESA_B>=empresa_b,empresa_b:<CODIGO_SN_EMPRESA_A>=empresa_a"   # (SAP_B1_INTERCOMPANY)
encrypt = true                      # (SAP_B1_ENCRYPT) TLS hacia HANA
ssl_validate_certificate = true     # (SAP_B1_SSL_VALIDATE_CERTIFICATE)
connect_timeout_seconds = 15        # (SAP_B1_CONNECT_TIMEOUT_SECONDS)

[upload]
bucket = "<BUCKET>"                 # (OMEGA_S3_BUCKET)
region = "<AWS_REGION>"             # (AWS_REGION; si falta, tambien AWS_DEFAULT_REGION)
access_key_id = "<ACCESS_KEY_ID>"           # (AWS_ACCESS_KEY_ID)
secret_access_key = "<SECRET_ACCESS_KEY>"   # (AWS_SECRET_ACCESS_KEY)
max_attempts = 5                    # intentos por archivo antes de dejarlo en la cola local

SAP_B1_PORT=<TENANT_SQL_PORT>

SAP_B1_USER=<OMEGA_B1_READER>
SAP_B1_PASSWORD=<PASSWORD_FROM_CUSTOMER_IT_VIA_SECURE_CHANNEL>

SAP_B1_DATABASE=

SAP_B1_COMPANIES="mx_mfg=<COMPANY_DB_1>,mx_dist_a=<COMPANY_DB_2>,mx_dist_b=<COMPANY_DB_3>"

SAP_B1_INTERCOMPANY="mx_mfg:<IC_CARDCODE_DIST_A>=mx_dist_a,mx_mfg:<IC_CARDCODE_DIST_B>=mx_dist_b,mx_dist_a:<IC_CARDCODE_MFG>=mx_mfg,mx_dist_b:<IC_CARDCODE_MFG>=mx_mfg"
SAP_B1_BUSINESS_PARAMETERS="threshold:*:*:margin_min_pct=<MARGEN_MINIMO_PCT>;setting:*:*:reconciliation_tolerance_pct=1"


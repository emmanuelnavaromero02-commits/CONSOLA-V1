# SAP Business One cartridge: connection settings for the `hana` dialect.
#
# Where the values go: the host .env the compose files read (infra/.env on
# the OMEGA host), or the Console Vault connection sap_b1/default (see
# vault_connection.template.json). When both are set, the environment wins
# (app/core/vault_client.get_secret_for_worker reads env first).
#
# Every value below is a placeholder. A filled copy of this file is a secret:
# never commit it, never paste it into a ticket. The cartridge never returns
# host, user or password over HTTP and strips them from driver errors.

# Dialect: hana in production, postgres only for the Business One-shaped test bed.
SAP_B1_DIALECT=hana

# Address the sap-b1 CONTAINER can reach. With the WireGuard kit (../vpn) this
# is the customer's peer address inside the tunnel: the customer's Windows
# server relays that one port to HANA. It is never the customer's public IP.
SAP_B1_HOST=<HANA_HOST_OR_TUNNEL_ADDRESS>

# Tenant SQL port, from hana/00_find_tenant_sql_port.sql. Empty means 30015.
# 3NN13 is SYSTEMDB: then SAP_B1_DATABASE must name the tenant.
SAP_B1_PORT=<TENANT_SQL_PORT>

# Read-only technical user created with hana/01_create_readonly_user.sql.
SAP_B1_USER=<OMEGA_B1_READER>
SAP_B1_PASSWORD=<PASSWORD_FROM_CUSTOMER_IT_VIA_SECURE_CHANNEL>

# Tenant database name. Only when SAP_B1_PORT is the SYSTEMDB port; leave
# empty when connecting straight to the tenant port.
SAP_B1_DATABASE=

# alias=SCHEMA pairs, one per company. The alias is what the lakehouse sees
# (the _company column and the entity@alias watermark); the schema name never
# leaves this configuration. Aliases: lowercase letters, digits, underscore.
SAP_B1_COMPANIES="mx_mfg=<COMPANY_DB_1>,mx_dist_a=<COMPANY_DB_2>,mx_dist_b=<COMPANY_DB_3>"

# TLS between the container and HANA. Keep it on even inside the tunnel.
SAP_B1_ENCRYPT=true

# Certificate validation. true requires the HANA server certificate to be
# issued by a CA the container trusts AND to carry SAP_B1_HOST in its SAN.
# Business One installs usually ship a self-signed certificate and a tunnel
# address is never in it: then set false (the session is still TLS-encrypted
# and the WireGuard tunnel authenticates both ends) and record the decision.
# NOTE: infra/docker-compose.yml passes SAP_B1_ENCRYPT to the sap-b1 service
# but not this variable nor the timeout below; add them to the service
# environment or the container keeps the defaults (true / 15).
SAP_B1_SSL_VALIDATE_CERTIFICATE=true

# Seconds to wait for the TCP + TLS handshake before the run is marked failed.
SAP_B1_CONNECT_TIMEOUT_SECONDS=15

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Env (NEVER commit these — see SECURITY.md, enforced by
# tests/test_env_never_in_git.py)
.env
.env.local
*.env
# but DO commit the placeholder templates that document the schema
!.env.example
!infra/.env.example
*.env.local
*.env.save
.env.save
infra/.env.save
# Belt and suspenders for the audit — explicit per-service paths so a
# stray `*.env` rule change can't accidentally re-expose any of them.
infra/.env
workspace/.env
console/.env
vault/secrets.yaml
*.secret
*.secrets
secrets/

# Data
data/
*.parquet
*.duckdb

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Docker
*.log

# Airflow runtime artefacts
airflow/logs/

# Local audit / review artefacts (never committed)
_audit_out/
*.zip

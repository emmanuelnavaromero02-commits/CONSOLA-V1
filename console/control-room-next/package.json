  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  }

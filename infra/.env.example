# === Bootstrap admin (manual first boot CLI only) ===
# v1.43.4: `python -m app.bootstrap_admin` is the manual CLI that
# creates the initial admin user. Pre-v1.43.4
# the display-name variable wasn't documented in the schema, so
# operators silently shipped without it.
#
# REQUIRED ONLY on the very first boot of a fresh database. After
# the first successful login:
#   1. Change the password via the UI.
#   2. REMOVE these three lines from infra/.env.
#   3. Restart console (env vars are read at startup).
#
# Use the placeholder values below only as a structural reference.
# The password placeholder is deliberately public and bootstrap_admin.py
# rejects it; replace it with a fresh strong value before running the
# manual bootstrap command. NEVER commit real values.
BOOTSTRAP_ADMIN_EMAIL=admin@change-me.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeFirstBoot123!
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator

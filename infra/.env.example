# CONSOLA-BETA / OMEGA — Environment variables template.
#
# DO NOT FILL THIS FILE. Run `bash infra/bootstrap.sh` (and then
# `bash infra/bootstrap-keys.sh infra/.env`) to generate a real
# infra/.env with random secrets. See SECURITY.md.
#
# This file documents WHICH variables the stack needs, NOT what they
# should be. Real secrets are NEVER committed to git — the
# tests/test_env_never_in_git.py audit guard enforces this.

# === Required secrets (auto-generated by bootstrap.sh) ===
INTERNAL_API_KEY=<generated-32-bytes-hex>
JWT_SECRET_KEY=<generated-32-bytes-hex>
SUPERSET_SECRET_KEY=<generated-32-bytes-hex>
AIRFLOW_SECRET_KEY=<generated-32-bytes-hex>
POSTGRES_PASSWORD=<generated-16-bytes-hex>
MINIO_SECRET_KEY=<generated-16-bytes-hex>
SUPERSET_ADMIN_PASSWORD=<generated-16-bytes-hex>
SUPERSET_SERVICE_PASSWORD=<service-account-password>
AIRFLOW_ADMIN_PASSWORD=<generated-16-bytes-hex>
AGENT_RUNNER_TOKEN=<generated-32-bytes-hex>

# === Service-specific Postgres passwords (v1.19) ===
# Each backend service connects to Postgres with its own login role
# instead of the shared `postgres` superuser. Generated by bootstrap.sh.
# See infra/init/25_service_roles.sql for the GRANT matrix.
OMEGA_CONSOLE_PASSWORD=<generated-16-bytes-hex>
OMEGA_REFINEMENT_PASSWORD=<generated-16-bytes-hex>
OMEGA_REFINEMENT_GOLD_PASSWORD=<generated-16-bytes-hex>
OMEGA_VAULT_PASSWORD=<generated-16-bytes-hex>
OMEGA_WORKSPACE_PASSWORD=<generated-16-bytes-hex>
OMEGA_MCP_INFRA_PASSWORD=<generated-16-bytes-hex>

# === SAP cartridges + Airflow/Superset metastore roles (v1.38) ===
# Replaced the postgres superuser in the SAP cartridge runtime, the
# Airflow webserver/scheduler, the Superset webserver, and the
# AIRFLOW_VAR_POSTGRES_CONN DAG variable. See
# infra/init/36_cartridge_and_meta_roles.sql.
OMEGA_CARTRIDGE_SAP_HCM_PASSWORD=<generated-16-bytes-hex>
OMEGA_CARTRIDGE_SAP_S4_PASSWORD=<generated-16-bytes-hex>
OMEGA_CARTRIDGE_SAP_SF_PASSWORD=<generated-16-bytes-hex>
OMEGA_AIRFLOW_DAG_PASSWORD=<generated-16-bytes-hex>
OMEGA_AIRFLOW_META_PASSWORD=<generated-16-bytes-hex>
OMEGA_SUPERSET_META_PASSWORD=<generated-16-bytes-hex>

# === Replicon cartridge restored (v1.40) ===
# Replicon cartridge runs as a standalone service that pulls bearer
# tokens from OMEGA Vault on every DAG run. The DB role + 3 pair
# keys (replicon -> console / mcp-infra / refinement) are created
# by infra/init/37_replicon_role_and_tables.sql.
OMEGA_CARTRIDGE_REPLICON_PASSWORD=<generated-16-bytes-hex>
INTERNAL_API_KEY_REPLICON_TO_CONSOLE=<generated-32-bytes-hex>
INTERNAL_API_KEY_REPLICON_TO_MCP_INFRA=<generated-32-bytes-hex>
INTERNAL_API_KEY_REPLICON_TO_REFINEMENT=<generated-32-bytes-hex>

# === Vault encryption at rest (v1.15) ===
# Fernet master key, URL-safe base64 of 32 random bytes. Generate with:
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# WARNING: rotating this key WITHOUT re-encrypting existing rows makes
# every stored secret unrecoverable. Use `make rotate-keys` for a full,
# coordinated regeneration.
VAULT_ENCRYPTION_KEY=<fernet-32-bytes-url-base64>

# === SAP PII field encryption (v1.33) ===
# Fernet master key used by SAP cartridges (sap_hcm, sap_s4hana,
# sap_successfactors) to encrypt PII columns (Pernr, Gbdat, salary,
# banking, etc.) before parquet write. Generate with:
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# The cartridges refuse to start without it — no hardcoded fallback.
FIELD_ENCRYPTION_KEY=<fernet-32-bytes-url-base64>

# === Per-pair INTERNAL_API_KEY (v1.12, auto-generated by bootstrap-keys.sh) ===
INTERNAL_API_KEY_CONSOLE_TO_REFINEMENT=<generated-32-bytes-hex>
INTERNAL_API_KEY_CONSOLE_TO_CONSOLE=<generated-32-bytes-hex>
INTERNAL_API_KEY_CONSOLE_TO_VAULT=<generated-32-bytes-hex>
INTERNAL_API_KEY_CONSOLE_TO_MCP_INFRA=<generated-32-bytes-hex>
INTERNAL_API_KEY_CONSOLE_TO_CARTRIDGE=<generated-32-bytes-hex>
INTERNAL_API_KEY_AIRFLOW_TO_CARTRIDGE=<generated-32-bytes-hex>
INTERNAL_API_KEY_WORKSPACE_TO_CONSOLE=<generated-32-bytes-hex>
INTERNAL_API_KEY_WORKSPACE_TO_REFINEMENT=<generated-32-bytes-hex>
INTERNAL_API_KEY_WORKSPACE_TO_MCP_INFRA=<generated-32-bytes-hex>
INTERNAL_API_KEY_AIRFLOW_TO_MCP_INFRA=<generated-32-bytes-hex>
INTERNAL_API_KEY_AIRFLOW_TO_REFINEMENT=<generated-32-bytes-hex>
INTERNAL_API_KEY_AIRFLOW_TO_CONSOLE=<generated-32-bytes-hex>
INTERNAL_API_KEY_REFINEMENT_TO_MCP_INFRA=<generated-32-bytes-hex>
INTERNAL_API_KEY_MCP_INFRA_TO_VAULT=<generated-32-bytes-hex>
INTERNAL_API_KEY_CARTRIDGE_TO_CONSOLE=<generated-32-bytes-hex>
INTERNAL_API_KEY_CARTRIDGE_TO_REFINEMENT=<generated-32-bytes-hex>
# Sprint v1.26 (audit F11): workspace + refinement don't call vault TODAY
# but vault still accepts them via the legacy shared INTERNAL_API_KEY.
# These keys are provisioned defensively so a future call site can switch
# to the dedicated credential; until then, vault logs WARNING when the
# legacy key is used.
INTERNAL_API_KEY_WORKSPACE_TO_VAULT=<generated-32-bytes-hex>
INTERNAL_API_KEY_REFINEMENT_TO_VAULT=<generated-32-bytes-hex>

# === Admin usernames ===
SUPERSET_ADMIN_USER=admin

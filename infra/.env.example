# CONSOLA-BETA / OMEGA — Environment variables template.
#
# DO NOT FILL THIS FILE. Run `bash infra/bootstrap.sh` (and then
# `bash infra/bootstrap-keys.sh infra/.env`) to generate a real
# infra/.env with random secrets. See SECURITY.md.
#
# This file documents WHICH variables the stack needs, NOT what they
# should be. Real secrets are NEVER committed to git — the
# tests/test_env_never_in_git.py audit guard enforces this.

# === Required secrets (auto-generated by bootstrap.sh) ===
INTERNAL_API_KEY=<generated-32-bytes-hex>
JWT_SECRET_KEY=<generated-32-bytes-hex>
SUPERSET_SECRET_KEY=<generated-32-bytes-hex>
AIRFLOW_SECRET_KEY=<generated-32-bytes-hex>
POSTGRES_PASSWORD=<generated-16-bytes-hex>
MINIO_SECRET_KEY=<generated-16-bytes-hex>
SUPERSET_ADMIN_PASSWORD=<generated-16-bytes-hex>
AIRFLOW_ADMIN_PASSWORD=<generated-16-bytes-hex>

# === Service-specific Postgres passwords (v1.19) ===
# Each backend service connects to Postgres with its own login role
# instead of the shared `postgres` superuser. Generated by bootstrap.sh.
# See infra/init/25_service_roles.sql for the GRANT matrix.
OMEGA_CONSOLE_PASSWORD=<generated-16-bytes-hex>
OMEGA_REFINEMENT_PASSWORD=<generated-16-bytes-hex>
OMEGA_VAULT_PASSWORD=<generated-16-bytes-hex>
OMEGA_WORKSPACE_PASSWORD=<generated-16-bytes-hex>
OMEGA_MCP_INFRA_PASSWORD=<generated-16-bytes-hex>

# === Vault encryption at rest (v1.15) ===
# Fernet master key, URL-safe base64 of 32 random bytes. Generate with:
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# WARNING: rotating this key WITHOUT re-encrypting existing rows makes
# every stored secret unrecoverable. Use `make rotate-keys` for a full,
# coordinated regeneration.
VAULT_ENCRYPTION_KEY=<fernet-32-bytes-url-base64>

# === Per-pair INTERNAL_API_KEY (v1.12, auto-generated by bootstrap-keys.sh) ===
INTERNAL_API_KEY_CONSOLE_TO_REFINEMENT=<generated-32-bytes-hex>
INTERNAL_API_KEY_CONSOLE_TO_VAULT=<generated-32-bytes-hex>
INTERNAL_API_KEY_CONSOLE_TO_MCP_INFRA=<generated-32-bytes-hex>
INTERNAL_API_KEY_WORKSPACE_TO_CONSOLE=<generated-32-bytes-hex>
INTERNAL_API_KEY_WORKSPACE_TO_REFINEMENT=<generated-32-bytes-hex>
INTERNAL_API_KEY_WORKSPACE_TO_MCP_INFRA=<generated-32-bytes-hex>
INTERNAL_API_KEY_AIRFLOW_TO_MCP_INFRA=<generated-32-bytes-hex>
INTERNAL_API_KEY_AIRFLOW_TO_REFINEMENT=<generated-32-bytes-hex>
INTERNAL_API_KEY_MCP_INFRA_TO_VAULT=<generated-32-bytes-hex>
INTERNAL_API_KEY_CARTRIDGE_TO_CONSOLE=<generated-32-bytes-hex>
INTERNAL_API_KEY_CARTRIDGE_TO_REFINEMENT=<generated-32-bytes-hex>

# === Admin usernames ===
SUPERSET_ADMIN_USER=admin
AIRFLOW_ADMIN_USER=admin

# === JWT runtime ===
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# === SMTP ===
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@omega.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# === CORS / public URLs ===
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8001
CONSOLE_URL=http://localhost:8000
WORKSPACE_PUBLIC_URL=http://localhost:8001

# === Token TTLs ===
INVITE_TOKEN_TTL_HOURS=72
RESET_TOKEN_TTL_HOURS=1

# === LLM defaults ===
CHAT_LLM_PROVIDER=gemini
CHAT_LLM_MODEL=gemini-1.5-flash
SQL_LLM_MODEL=claude-sonnet-4-6
GEMINI_CACHE_ENABLED=true

# === LLM API keys — fill via Settings UI (Fase 2) ===
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# === Integration creds — fill via Settings UI (NEVER hardcode here) ===
REPLICON_TOKEN=
REPLICON_BASE_URL=https://na5.replicon.com/analytics
REPLICON_USE_DEMO=false
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_BASE_URL=
SF_COMPANY_ID=
SF_TOKEN_URL=
SAP_HCM_USER=
SAP_HCM_PASS=
SAP_HCM_BASE_URL=
SAP_HCM_CLIENT_MANDANT=
SAP_S4_USER=
SAP_S4_PASS=
SAP_S4_BASE_URL=
SAP_S4_CLIENT_MANDANT=100
SAP_S4_API_KEY=
OUTLOOK_APP_PASSWORD=

# === Internal service URLs ===
# Most callers hardcode `http://refinement:8500` (Docker DNS), so this
# is only useful when running console outside the compose network.
REFINEMENT_URL=http://refinement:8500

# === Optional infra ===
REDIS_URL=
EMBED_DIM=
EMBED_MODEL=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PG_DSN=
MINIO_ROOT_PASSWORD=

# === App env ===
APP_ENV=development
COOKIE_SECURE=

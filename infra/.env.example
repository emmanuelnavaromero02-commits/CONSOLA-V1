INTERNAL_API_KEY=pon_aqui_una_clave_larga_y_segura_de_ejemplo

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
INTERNAL_API_KEY=
REPLICON_BASE_URL=https://na5.replicon.com/analytics
REPLICON_TOKEN=
REPLICON_USE_DEMO=false

# ── Postgres (contenedores en EC2 App, antes RDS) ─────────────────────────────
# Debe coincidir con postgres_password en infra/terraform/infra/secrets.auto.tfvars
POSTGRES_PASSWORD=

# ── AWS (sólo para deploy AWS) ────────────────────────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET_NAME=
CONSOLE_URL=

# ── Superset ───────────────────────────────────────────────────────────────────
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_PASSWORD=

# ── Airflow ────────────────────────────────────────────────────────────────────
AIRFLOW_SECRET_KEY=

# ── LLM config ────────────────────────────────────────────────────────────────
# Chat UI (asistente conversacional)
#   gemini (default) | anthropic | ollama
CHAT_LLM_PROVIDER=gemini
#   gemini:    gemini-1.5-flash | gemini-1.5-pro | gemini-2.0-flash
#   anthropic: claude-haiku-4-5-20251001 | claude-sonnet-4-6
CHAT_LLM_MODEL=gemini-1.5-flash

# SQL / generación de objetos (refinement)
SQL_LLM_MODEL=claude-sonnet-4-6

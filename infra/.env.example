# === Required secrets — auto-generated by infra/bootstrap.sh ===
# generate each with: openssl rand -hex 32
INTERNAL_API_KEY=
JWT_SECRET_KEY=
SUPERSET_SECRET_KEY=
AIRFLOW_SECRET_KEY=
# generate each with: openssl rand -hex 16
POSTGRES_PASSWORD=
MINIO_SECRET_KEY=
SUPERSET_ADMIN_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
# admin usernames (free text)
SUPERSET_ADMIN_USER=admin
AIRFLOW_ADMIN_USER=admin
# JWT runtime config (non-secret defaults)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Postgres / MinIO extras
PG_DSN=
MINIO_ROOT_PASSWORD=

# === LLM API keys — fill via UI Settings (Fase 2) ===
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
CHAT_LLM_PROVIDER=gemini
CHAT_LLM_MODEL=gemini-1.5-flash
SQL_LLM_MODEL=claude-sonnet-4-6
GEMINI_CACHE_ENABLED=true

# === Integrations — fill via UI Settings (Fase 2) ===
REPLICON_TOKEN=
REPLICON_BASE_URL=https://na5.replicon.com/analytics
REPLICON_USE_DEMO=false
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SAP_HCM_USER=
SAP_HCM_PASS=
SAP_S4_USER=
SAP_S4_PASS=

# === SMTP ===
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@modecissions.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# === CORS / public URLs ===
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8001
CONSOLE_URL=http://localhost:8000
WORKSPACE_PUBLIC_URL=http://localhost:8001

# === Token TTLs ===
INVITE_TOKEN_TTL_HOURS=72
RESET_TOKEN_TTL_HOURS=1

# === AWS (unused for local Docker unless configured) ===
AWS_REGION=us-east-1
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

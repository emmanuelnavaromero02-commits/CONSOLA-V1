# MODecissions local environment example.
# Do not copy this file by hand — run `bash infra/bootstrap.sh` instead.
# bootstrap.sh fills the secret values via `openssl rand -hex …`.

# === Required secrets (auto-generated by infra/bootstrap.sh) ===
# generate with: openssl rand -hex 32
INTERNAL_API_KEY=
JWT_SECRET_KEY=
SUPERSET_SECRET_KEY=
AIRFLOW_SECRET_KEY=
# generate with: openssl rand -hex 16
POSTGRES_PASSWORD=
MINIO_SECRET_KEY=
SUPERSET_ADMIN_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=

# === Admin usernames (non-secret) ===
SUPERSET_ADMIN_USER=admin
AIRFLOW_ADMIN_USER=admin

# === JWT runtime ===
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# === SMTP ===
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@modecissions.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# === CORS / public URLs ===
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8001
CONSOLE_URL=http://localhost:8000
WORKSPACE_PUBLIC_URL=http://localhost:8001

# === Token TTLs ===
INVITE_TOKEN_TTL_HOURS=72
RESET_TOKEN_TTL_HOURS=1

# === LLM defaults ===
CHAT_LLM_PROVIDER=gemini
CHAT_LLM_MODEL=gemini-1.5-flash
SQL_LLM_MODEL=claude-sonnet-4-6
GEMINI_CACHE_ENABLED=true

# === Replicon ===
REPLICON_BASE_URL=https://na5.replicon.com/analytics
REPLICON_USE_DEMO=false
REPLICON_MOCK_USER_COUNT=

# === Redis / embeddings (compose has working defaults if blank) ===
REDIS_URL=
EMBED_DIM=
EMBED_MODEL=

# === AWS ===
AWS_REGION=us-east-1

# === LLM keys — fill via UI Settings (Fase 2) ===
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# === Integrations — fill via UI Settings (Fase 2) ===
REPLICON_TOKEN=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_BASE_URL=
SF_COMPANY_ID=
SF_TOKEN_URL=
SAP_HCM_USER=
SAP_HCM_PASS=
SAP_HCM_BASE_URL=
SAP_HCM_CLIENT_MANDANT=
SAP_S4_USER=
SAP_S4_PASS=
OUTLOOK_APP_PASSWORD=

# === S3 / DB extras (optional) ===
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PG_DSN=
MINIO_ROOT_PASSWORD=

# ======================================================
# MODecissions — AWS Environment Config
# Copiar a .env y completar todos los valores
# Permisos: chmod 600 .env
# ======================================================

# --- Postgres (en contenedor en EC2 App; sin RDS) ---
POSTGRES_PASSWORD=         # debe coincidir con el postgres_password de secrets.auto.tfvars

# --- Terraform Outputs ---
S3_BUCKET_NAME=            # terraform output s3_bucket_name
AWS_REGION=us-east-1

# --- AWS keys para Airflow DAGs ---
# El Python minio client no soporta IAM role; necesita keys explícitas.
# Crea un IAM user "modecissions-airflow-s3" con AmazonS3FullAccess (o policy
# scoped al bucket lakehouse) y pega aquí las access keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- URLs públicas (vistas por el browser del usuario, vía VPN) ---
# Sustituye 10.0.2.X por la IP privada de la EC2 App: terraform output ec2_app_private_ip
CONSOLE_URL=http://10.0.2.X:8000
WORKSPACE_PUBLIC_URL=http://10.0.2.X:8001

# --- LLM Config ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CHAT_LLM_PROVIDER=anthropic
CHAT_LLM_MODEL=claude-haiku-4-5-20251001
SQL_LLM_MODEL=claude-sonnet-4-6
GEMINI_CACHE_ENABLED=true

# --- Embeddings (RAG) ---
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# --- Superset ---
SUPERSET_SECRET_KEY=        # python3 -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_ADMIN_PASSWORD=

# --- Airflow ---
AIRFLOW_SECRET_KEY=         # python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_ADMIN_USER=admin    # usuario admin de Airflow (default: admin)
AIRFLOW_ADMIN_PASSWORD=     # password fuerte; mcp-infra lo usa para llamar al REST API de Airflow

# --- Email / SMTP ---
# Defaults apuntan al contenedor MailHog (dev/staging — no envía emails reales,
# los captura en su web UI: http://10.0.2.X:8025).
# Para producción real con AWS SES, sobreescribe con:
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USER=AKIA...                  (SMTP credentials de SES)
#   SMTP_PASSWORD=...                  (password derivado del access key)
#   SMTP_FROM=noreply@tu-dominio
#   SMTP_USE_TLS=true
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@modecissions.local
SMTP_USE_TLS=false

# --- Token TTLs ---
INVITE_TOKEN_TTL_HOURS=72
RESET_TOKEN_TTL_HOURS=1

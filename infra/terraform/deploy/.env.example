# MODecissions AWS deploy environment example.
# Copy to .env on the EC2 app host and replace every CHANGEME value.

# Postgres containers on EC2 App
POSTGRES_PASSWORD=CHANGEME_generate_strong_postgres_password

# Internal service authentication
INTERNAL_API_KEY=CHANGE_ME_GENERATE_64_RANDOM_CHARS_DO_NOT_USE_THIS_VALUE
# v1.44.3.2.2 R-Mac: include :3000 (Next.js console) so the
# console-next service in prod can POST cross-origin to the
# FastAPI backend on :8000. Replace 10.0.2.X with the LAN
# address of the EC2 host (or the public hostname behind the
# reverse proxy if console-next is served externally).
ALLOWED_ORIGINS=http://10.0.2.X:3000,http://10.0.2.X:8000,http://10.0.2.X:8001

# Console JWT access tokens
JWT_SECRET_KEY=CHANGEME_generate_64_plus_random_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Terraform outputs / AWS
S3_BUCKET_NAME=CHANGEME_terraform_output_s3_bucket_name
AWS_REGION=us-east-1
# AWS credentials are provided by the EC2 instance profile in production.
# Do not put static AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY values here.

# Public URLs visible through VPN
CONSOLE_URL=http://10.0.2.X:8000
WORKSPACE_PUBLIC_URL=http://10.0.2.X:8001
AIRFLOW_PUBLIC_URL=http://10.0.2.X:8082
SUPERSET_PUBLIC_URL=http://10.0.2.X:8088

# LLM config
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CHAT_LLM_PROVIDER=anthropic
CHAT_LLM_MODEL=claude-haiku-4-5-20251001
SQL_LLM_MODEL=claude-sonnet-4-6
GEMINI_CACHE_ENABLED=true

# Embeddings / RAG
OLLAMA_URL=http://host.docker.internal:11434
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Superset
SUPERSET_SECRET_KEY=CHANGEME_generate_64_hex_chars
SUPERSET_ADMIN_USER=CHANGEME_superset_admin_user
SUPERSET_ADMIN_PASSWORD=CHANGEME_generate_strong_superset_password
SUPERSET_SERVICE_USER=
SUPERSET_SERVICE_PASSWORD=

# Airflow
AIRFLOW_SECRET_KEY=CHANGEME_generate_64_hex_chars
AIRFLOW_ADMIN_USER=CHANGEME_airflow_admin_user
AIRFLOW_ADMIN_PASSWORD=CHANGEME_generate_strong_airflow_password
AGENT_RUNNER_TOKEN=CHANGEME_generate_64_hex_chars

# Email / SMTP
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@modecissions.local
SMTP_USE_TLS=false
ADMIN_EMAIL=

# VPN config delivery (WireGuard / wg-easy)
VPN_API_URL=
VPN_API_PASSWORD=
VPN_TOKEN_TTL_HOURS=72
VPN_CLIENT_ALLOWED_IPS=10.0.0.0/16,10.8.0.0/24
VPN_CLIENT_STRIP_DNS=true

# Token TTLs
INVITE_TOKEN_TTL_HOURS=72
RESET_TOKEN_TTL_HOURS=1

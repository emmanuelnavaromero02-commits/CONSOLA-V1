# MODecissions AWS deploy environment example.
# Copy to .env on the EC2 app host and replace every CHANGEME value.

# Postgres containers on EC2 App
POSTGRES_PASSWORD=CHANGEME_generate_strong_postgres_password

# Immutable release coordinates. In production these must be a tag or commit SHA,
# never "latest" or an unpinned branch.
DEPLOY_REF=v1.0.0-rc3
IMAGE_TAG=v1.0.0-rc3
DEPLOY_CARTRIDGES_SAME_HOST=true

# Cartridge upstream credentials. Required only when
# DEPLOY_CARTRIDGES_SAME_HOST=true or when those cartridge services are enabled.
REPLICON_BASE_URL=https://replicon.example.com
REPLICON_API_TOKEN=CHANGEME_replicon_token
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_API_TOKEN=CHANGEME_hubspot_private_app_token
HUBSPOT_URL=http://hubspot:8210
SALESFORCE_URL=http://salesforce:8205
SAP_HCM_BASE_URL=https://sap-hcm.example.com
SAP_HCM_USER=CHANGEME_sap_hcm_user
SAP_HCM_PASS=CHANGEME_sap_hcm_password
SAP_HCM_CLIENT_MANDANT=100
SAP_S4_BASE_URL=https://sap-s4hana.example.com
SAP_S4_USER=CHANGEME_sap_s4_user
SAP_S4_PASS=CHANGEME_sap_s4_password
SAP_S4_CLIENT_MANDANT=100
SAP_S4_API_KEY=CHANGEME_optional_sap_s4_api_key
SF_BASE_URL=https://successfactors.example.com
SF_COMPANY_ID=CHANGEME_sf_company
SF_CLIENT_ID=CHANGEME_sf_client
SF_CLIENT_SECRET=CHANGEME_sf_secret
SF_TOKEN_URL=https://successfactors.example.com/oauth/token

# Internal service authentication
INTERNAL_API_KEY=CHANGE_ME_GENERATE_64_RANDOM_CHARS_DO_NOT_USE_THIS_VALUE
SECURITY_CONTEXT_SIGNING_KEY=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_CONSOLE_TO_CONSOLE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_CONSOLE_TO_MCP_INFRA=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_MCP_INFRA_TO_CONSOLE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_CONSOLE_TO_REFINEMENT=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_CONSOLE_TO_CARTRIDGE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_AIRFLOW_TO_CARTRIDGE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_AIRFLOW_TO_CONSOLE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_WORKSPACE_TO_MCP_INFRA=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_WORKSPACE_TO_CONSOLE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_WORKSPACE_TO_REFINEMENT=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_AIRFLOW_TO_MCP_INFRA=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_AIRFLOW_TO_REFINEMENT=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_REFINEMENT_TO_MCP_INFRA=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_MCP_INFRA_TO_REFINEMENT=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_REFINEMENT_TO_VAULT=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_WORKSPACE_TO_VAULT=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_CARTRIDGE_TO_REFINEMENT=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_CARTRIDGE_TO_CONSOLE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_REPLICON_TO_CONSOLE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_REPLICON_TO_MCP_INFRA=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_REPLICON_TO_REFINEMENT=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_HUBSPOT_TO_CONSOLE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_HUBSPOT_TO_MCP_INFRA=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_HUBSPOT_TO_REFINEMENT=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_BANXICO_TO_CONSOLE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_INEGI_TO_CONSOLE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_SEC_EDGAR_TO_CONSOLE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_SALESFORCE_TO_CONSOLE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_SAP_HCM_TO_CONSOLE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_SAP_S4HANA_TO_CONSOLE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_SAP_SUCCESSFACTORS_TO_CONSOLE=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_CONSOLE_TO_VAULT=CHANGEME_generate_64_random_chars
INTERNAL_API_KEY_MCP_INFRA_TO_VAULT=CHANGEME_generate_64_random_chars

# Service database roles and encryption
OMEGA_CONSOLE_PASSWORD=CHANGEME_generate_role_password
OMEGA_REFINEMENT_PASSWORD=CHANGEME_generate_role_password
OMEGA_VAULT_PASSWORD=CHANGEME_generate_role_password
OMEGA_WORKSPACE_PASSWORD=CHANGEME_generate_role_password
OMEGA_MCP_INFRA_PASSWORD=CHANGEME_generate_role_password
OMEGA_REFINEMENT_GOLD_PASSWORD=CHANGEME_generate_role_password
OMEGA_AIRFLOW_DAG_PASSWORD=CHANGEME_generate_role_password
OMEGA_AIRFLOW_META_PASSWORD=CHANGEME_generate_role_password
OMEGA_CARTRIDGE_SAP_HCM_PASSWORD=CHANGEME_generate_role_password
OMEGA_CARTRIDGE_SAP_S4_PASSWORD=CHANGEME_generate_role_password
OMEGA_CARTRIDGE_SAP_SF_PASSWORD=CHANGEME_generate_role_password
OMEGA_CARTRIDGE_REPLICON_PASSWORD=CHANGEME_generate_role_password
OMEGA_CARTRIDGE_SALESFORCE_PASSWORD=CHANGEME_generate_role_password
OMEGA_CARTRIDGE_HUBSPOT_PASSWORD=CHANGEME_generate_role_password
OMEGA_CARTRIDGE_BANXICO_PASSWORD=CHANGEME_generate_role_password
OMEGA_CARTRIDGE_INEGI_PASSWORD=CHANGEME_generate_role_password
OMEGA_CARTRIDGE_SEC_EDGAR_PASSWORD=CHANGEME_generate_role_password
SEC_EDGAR_USER_AGENT="OMEGA ops@example.com"
VAULT_ENCRYPTION_KEY=CHANGEME_generate_fernet_key
FIELD_ENCRYPTION_KEY=CHANGEME_generate_fernet_key
# Browser-facing production origins are served by the public ALB over HTTPS.
APP_ENV=production
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://console.example.com,https://workspace.example.com

# Console JWT access tokens
JWT_SECRET_KEY=CHANGEME_generate_64_plus_random_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Terraform outputs / AWS
S3_BUCKET_NAME=CHANGEME_terraform_output_s3_bucket_name
AWS_REGION=us-east-1
# AWS credentials are provided by the EC2 instance profile in production.
# Do not put static AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY values here.

# Public URLs visible through the HTTPS ALB. Internal service-to-service URLs
# stay on compose DNS names in docker-compose.aws.yml.
CONSOLE_URL=https://console.example.com
WORKSPACE_PUBLIC_URL=https://workspace.example.com
AIRFLOW_PUBLIC_URL=https://console.example.com/airflow
# Superset is internal/admin-only by default for beta. Leave empty unless an
# explicit admin-only proxy has been deployed and tested.
SUPERSET_PUBLIC_URL=

# LLM config
ANTHROPIC_API_KEY=
CHAT_LLM_PROVIDER=anthropic
CHAT_LLM_MODEL=claude-haiku-4-5-20251001
SQL_LLM_MODEL=claude-sonnet-4-6

# Embeddings / RAG
EMBED_MODEL=amazon.titan-embed-text-v2:0
EMBED_DIM=1024
RAG_LOCAL_EMBEDDING_FALLBACK=true
BEDROCK_REGION=

# Superset
SUPERSET_SECRET_KEY=CHANGEME_generate_64_hex_chars
SUPERSET_PREVIOUS_SECRET_KEY=
OMEGA_SUPERSET_META_PASSWORD=CHANGEME_generate_strong_superset_metastore_password
SUPERSET_ADMIN_USER=CHANGEME_superset_admin_user
SUPERSET_ADMIN_PASSWORD=CHANGEME_generate_strong_superset_password
SUPERSET_SERVICE_USER=omega_service
SUPERSET_SERVICE_PASSWORD=CHANGEME_service_account_password
SUPERSET_TALISMAN_ENABLED=true
SUPERSET_CSRF_ENABLED=true
SUPERSET_RATELIMIT_ENABLED=true
SUPERSET_RATELIMIT_STORAGE_URI=redis://redis:6379/1

# Airflow
AIRFLOW_SECRET_KEY=CHANGEME_generate_64_hex_chars
AIRFLOW_ADMIN_USER=CHANGEME_airflow_admin_user
AIRFLOW_ADMIN_PASSWORD=CHANGEME_generate_strong_airflow_password
AGENT_RUNNER_TOKEN=CHANGEME_generate_64_hex_chars

# Email / SMTP
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@modecissions.local
SMTP_USE_TLS=false
ADMIN_EMAIL=

# VPN config delivery (WireGuard / wg-easy)
VPN_API_URL=
VPN_API_PASSWORD=
VPN_TOKEN_TTL_HOURS=72
VPN_CLIENT_ALLOWED_IPS=10.0.0.0/16,10.8.0.0/24
VPN_CLIENT_STRIP_DNS=true

# Token TTLs
INVITE_TOKEN_TTL_HOURS=72
RESET_TOKEN_TTL_HOURS=1

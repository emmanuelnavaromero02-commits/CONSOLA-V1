aws_region = "us-east-1"

github_repo_url = "git@github.com:emmanuelnavaromero02-commits/CONSOLA-V1.git"
deploy_ref      = "v1.0.0-rc3"
image_tag       = "v1.0.0-rc3"

app_env           = "staging"
app_instance_type = "m7i-flex.large"
egress_mode       = "nat_instance"
nat_instance_type = "t3.micro"
enable_vpn        = false

public_console_domain   = "console.7businesssolutions.com"
public_workspace_domain = "workspace.7businesssolutions.com"

route53_zone_id = ""

manual_acm_validation_complete = false

public_acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

ssh_allowed_cidrs = []

alarm_email = "ops@example.com"

enable_monthly_budget    = true
monthly_budget_limit_usd = 50
budget_actual_thresholds = [50, 80, 100]
budget_forecast_thresholds = [100]

enable_public_alb_waf             = true
public_alb_waf_rate_limit         = 2000
public_alb_waf_common_rule_action = "count"

email_provider    = "ses"
ses_sender_domain = "7businesssolutions.com"
smtp_host         = "email-smtp.us-east-1.amazonaws.com"
smtp_port         = 587
smtp_user        = ""
smtp_from        = "no-reply@7businesssolutions.com"
smtp_from_domain = "7businesssolutions.com"
smtp_use_tls     = true

vpn_admin_allowed_cidrs = []

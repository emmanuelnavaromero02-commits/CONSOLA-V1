project_id         = "project-dd5ba7fa-374c-4554-ae6"
project_number     = "894064513501"
billing_account_id = "01A3E0-B708F4-6EA299"

region      = "us-central1"
zone        = "us-central1-a"
environment = "staging"

source_bucket = "omega-gcp-source-project-dd5ba7fa-374c-4554-ae6"
source_object = "CONSOLA-V1-<sha>.tar.gz"
source_sha    = "<sha>"

app_machine_type = "e2-standard-4"
data_disk_size_gb = 150
admin_email       = "emmanuelromero060601@gmail.com"

# Leave empty for technical HTTP/IP mode. Set both domains to enable managed
# HTTPS, host rules, and HTTP -> HTTPS redirect on the main public IP.
public_console_domain   = ""
public_workspace_domain = ""
enable_https            = true

# GCP lakehouse is exposed to the app through the GCS S3-compatible XML API.
lakehouse_endpoint    = "storage.googleapis.com"
lakehouse_bucket_name = ""

# Phase 2 Talent 9-Box shadow. Use a dedicated project because the BigQuery
# query quota override is project-wide. Keep runtime false until the exact
# Main Workspace UUID has been allowlisted and IAM is applied.
provision_bigquery_talent_shadow       = false
bigquery_talent_shadow_runtime_enabled = false
bigquery_shadow_project_id             = ""
bigquery_shadow_main_tenant_id          = ""
bigquery_shadow_main_workspace_id      = ""

enable_airflow_scheduler = true
enable_lb_logging        = true
lb_log_sample_rate       = 1.0

enable_budget            = true
monthly_budget_limit_usd = 100
monthly_budget_currency  = "EUR"

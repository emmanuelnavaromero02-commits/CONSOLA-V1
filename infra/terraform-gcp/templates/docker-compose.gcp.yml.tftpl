x-gcp-lakehouse-env: &gcp-lakehouse-env
  LAKEHOUSE_PROVIDER: $${LAKEHOUSE_PROVIDER:-gcs}
  LAKEHOUSE_BUCKET: $${LAKEHOUSE_BUCKET:-}
  GCS_BUCKET: $${GCS_BUCKET:-}
  LAKEHOUSE_ENDPOINT: $${LAKEHOUSE_ENDPOINT:-storage.googleapis.com}
  S3_BUCKET_NAME: $${S3_BUCKET_NAME:-}
  S3_ENDPOINT_URL: $${S3_ENDPOINT_URL:-}
  MINIO_BUCKET: ""
  MINIO_ENDPOINT: ""
  MINIO_ACCESS_KEY: ""
  MINIO_SECRET_KEY: ""
  MINIO_SECURE: $${MINIO_SECURE:-true}
  GCS_ACCESS_KEY_ID: $${GCS_ACCESS_KEY_ID:-}
  GCS_SECRET_ACCESS_KEY: $${GCS_SECRET_ACCESS_KEY:-}
  LAKEHOUSE_ACCESS_KEY: $${LAKEHOUSE_ACCESS_KEY:-}
  LAKEHOUSE_SECRET_KEY: $${LAKEHOUSE_SECRET_KEY:-}
  # Generic AWS credentials never enter GCP application containers. The
  # optional SES inbox requires dedicated SES_INBOX_AWS_* credentials and is
  # disabled until those are provisioned by a separate release.
  AWS_ACCESS_KEY_ID: ""
  AWS_SECRET_ACCESS_KEY: ""
  AWS_SESSION_TOKEN: ""
  AWS_DEFAULT_REGION: $${AWS_DEFAULT_REGION:-auto}
  AWS_REGION: $${AWS_REGION:-auto}
  REPLICON_SES_INBOX_ENABLED: "false"

services:
  console:
    environment:
      <<: *gcp-lakehouse-env
      COOKIE_SECURE: $${COOKIE_SECURE:-true}
      WORKSPACE_URL: $${WORKSPACE_PUBLIC_URL:-}
      WORKSPACE_PUBLIC_URL: $${WORKSPACE_PUBLIC_URL:-}
      AIRFLOW_PUBLIC_URL: $${AIRFLOW_PUBLIC_URL:-}
      SUPERSET_PUBLIC_URL: $${SUPERSET_PUBLIC_URL:-}
      CONTROL_ROOM_EVIDENCE_SIGNING_KEY_ID: $${CONTROL_ROOM_EVIDENCE_SIGNING_KEY_ID:?CONTROL_ROOM_EVIDENCE_SIGNING_KEY_ID is required}
      CONTROL_ROOM_EVIDENCE_SIGNING_KEY: $${CONTROL_ROOM_EVIDENCE_SIGNING_KEY:?CONTROL_ROOM_EVIDENCE_SIGNING_KEY is required}
      CONTROL_ROOM_EVIDENCE_SIGNING_PREVIOUS_KEYS: $${CONTROL_ROOM_EVIDENCE_SIGNING_PREVIOUS_KEYS:-}
  workspace:
    environment:
      <<: *gcp-lakehouse-env
      COOKIE_SECURE: $${COOKIE_SECURE:-true}
      CONSOLE_URL: $${CONSOLE_URL:-}
      WORKSPACE_PUBLIC_URL: $${WORKSPACE_PUBLIC_URL:-}
  refinement:
    environment:
      <<: *gcp-lakehouse-env
  vault:
    environment:
      <<: *gcp-lakehouse-env
  replicon:
    environment:
      <<: *gcp-lakehouse-env
  salesforce:
    environment:
      <<: *gcp-lakehouse-env
  hubspot:
    environment:
      <<: *gcp-lakehouse-env
  banxico:
    environment:
      <<: *gcp-lakehouse-env
  inegi:
    environment:
      <<: *gcp-lakehouse-env
  sec-edgar:
    environment:
      <<: *gcp-lakehouse-env
      SEC_EDGAR_USER_AGENT: $${SEC_EDGAR_USER_AGENT:-}
  sap-successfactors:
    environment:
      <<: *gcp-lakehouse-env
  sap-hcm:
    environment:
      <<: *gcp-lakehouse-env
  sap-s4hana:
    environment:
      <<: *gcp-lakehouse-env
  sap-b1:
    environment:
      <<: *gcp-lakehouse-env
  mcp-infra:
    environment:
      <<: *gcp-lakehouse-env
      AIRFLOW_URL: $${AIRFLOW_URL:-http://airflow:8080/airflow}
      MCP_INFRA_PDF_MAX_WORKERS: $${MCP_INFRA_PDF_MAX_WORKERS:-2}
    mem_limit: $${MCP_INFRA_MEM_LIMIT:-1536m}
    cpus: $${MCP_INFRA_CPUS:-2.0}
    pids_limit: $${MCP_INFRA_PIDS_LIMIT:-128}
  airflow:
    environment:
      <<: *gcp-lakehouse-env
      REPLICON_SES_INBOX_ENABLED: $${REPLICON_SES_INBOX_ENABLED:-false}
      SES_INBOX_AWS_ACCESS_KEY_ID: $${SES_INBOX_AWS_ACCESS_KEY_ID:-}
      SES_INBOX_AWS_SECRET_ACCESS_KEY: $${SES_INBOX_AWS_SECRET_ACCESS_KEY:-}
      SES_INBOX_AWS_REGION: $${SES_INBOX_AWS_REGION:-us-east-1}
      AIRFLOW__WEBSERVER__BASE_URL: $${AIRFLOW_PUBLIC_URL:-http://airflow:8080}
      AIRFLOW__WEBSERVER__ENABLE_PROXY_FIX: "True"
      AIRFLOW_HEALTH_PATH: $${AIRFLOW_HEALTH_PATH:-/airflow/health}
      AIRFLOW_VAR_LAKEHOUSE_PROVIDER: $${LAKEHOUSE_PROVIDER:-gcs}
      AIRFLOW_VAR_GCS_BUCKET: $${GCS_BUCKET:-}
      AIRFLOW_VAR_LAKEHOUSE_BUCKET: $${LAKEHOUSE_BUCKET:-}
      AIRFLOW_VAR_S3_BUCKET: $${S3_BUCKET_NAME:-}
      # The base Compose file still needs its local MinIO credentials, but a
      # GCP Airflow process must not receive them through the AIRFLOW_VAR_*
      # back door. Provider-aware DAGs use the GCS variables above.
      AIRFLOW_VAR_MINIO_BUCKET: ""
      AIRFLOW_VAR_MINIO_ENDPOINT: ""
      AIRFLOW_VAR_MINIO_ACCESS_KEY: ""
      AIRFLOW_VAR_MINIO_SECRET_KEY: ""
      AIRFLOW_VAR_MINIO_SECURE: ""
      SEC_EDGAR_URL: $${SEC_EDGAR_URL:-http://sec-edgar:8217}
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://127.0.0.1:8080$${AIRFLOW_HEALTH_PATH:-/health} || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
  airflow-init:
    environment:
      <<: *gcp-lakehouse-env
      REPLICON_SES_INBOX_ENABLED: $${REPLICON_SES_INBOX_ENABLED:-false}
      SES_INBOX_AWS_ACCESS_KEY_ID: $${SES_INBOX_AWS_ACCESS_KEY_ID:-}
      SES_INBOX_AWS_SECRET_ACCESS_KEY: $${SES_INBOX_AWS_SECRET_ACCESS_KEY:-}
      SES_INBOX_AWS_REGION: $${SES_INBOX_AWS_REGION:-us-east-1}
      AIRFLOW__WEBSERVER__BASE_URL: $${AIRFLOW_PUBLIC_URL:-http://airflow:8080}
      AIRFLOW__WEBSERVER__ENABLE_PROXY_FIX: "True"
      AIRFLOW_VAR_LAKEHOUSE_PROVIDER: $${LAKEHOUSE_PROVIDER:-gcs}
      AIRFLOW_VAR_GCS_BUCKET: $${GCS_BUCKET:-}
      AIRFLOW_VAR_LAKEHOUSE_BUCKET: $${LAKEHOUSE_BUCKET:-}
      AIRFLOW_VAR_S3_BUCKET: $${S3_BUCKET_NAME:-}
      AIRFLOW_VAR_MINIO_BUCKET: ""
      AIRFLOW_VAR_MINIO_ENDPOINT: ""
      AIRFLOW_VAR_MINIO_ACCESS_KEY: ""
      AIRFLOW_VAR_MINIO_SECRET_KEY: ""
      AIRFLOW_VAR_MINIO_SECURE: ""
      SEC_EDGAR_URL: $${SEC_EDGAR_URL:-http://sec-edgar:8217}
  airflow-scheduler:
    environment:
      <<: *gcp-lakehouse-env
      REPLICON_SES_INBOX_ENABLED: $${REPLICON_SES_INBOX_ENABLED:-false}
      SES_INBOX_AWS_ACCESS_KEY_ID: $${SES_INBOX_AWS_ACCESS_KEY_ID:-}
      SES_INBOX_AWS_SECRET_ACCESS_KEY: $${SES_INBOX_AWS_SECRET_ACCESS_KEY:-}
      SES_INBOX_AWS_REGION: $${SES_INBOX_AWS_REGION:-us-east-1}
      AIRFLOW__WEBSERVER__BASE_URL: $${AIRFLOW_PUBLIC_URL:-http://airflow:8080}
      AIRFLOW__WEBSERVER__ENABLE_PROXY_FIX: "True"
      AIRFLOW_HEALTH_PATH: $${AIRFLOW_HEALTH_PATH:-/airflow/health}
      AIRFLOW_VAR_LAKEHOUSE_PROVIDER: $${LAKEHOUSE_PROVIDER:-gcs}
      AIRFLOW_VAR_GCS_BUCKET: $${GCS_BUCKET:-}
      AIRFLOW_VAR_LAKEHOUSE_BUCKET: $${LAKEHOUSE_BUCKET:-}
      AIRFLOW_VAR_S3_BUCKET: $${S3_BUCKET_NAME:-}
      AIRFLOW_VAR_MINIO_BUCKET: ""
      AIRFLOW_VAR_MINIO_ENDPOINT: ""
      AIRFLOW_VAR_MINIO_ACCESS_KEY: ""
      AIRFLOW_VAR_MINIO_SECRET_KEY: ""
      AIRFLOW_VAR_MINIO_SECURE: ""
      SEC_EDGAR_URL: $${SEC_EDGAR_URL:-http://sec-edgar:8217}

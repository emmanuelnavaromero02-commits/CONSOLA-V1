#!/bin/sh -p
# Docker ExecStartPre gate for the canonical GCP runtime.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset ENV PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONINSPECT PYTHONUSERBASE \
  PYTHONWARNINGS PYTHONBREAKPOINT PYTHONSAFEPATH SSL_CERT_FILE SSL_CERT_DIR \
  REQUESTS_CA_BUNDLE CURL_CA_BUNDLE SSLKEYLOGFILE DOCKER_CONTEXT DOCKER_TLS \
  DOCKER_TLS_VERIFY DOCKER_CERT_PATH DOCKER_API_VERSION DOCKER_CONFIG \
  DOCKER_AUTH_CONFIG COMPOSE_FILE COMPOSE_PATH_SEPARATOR COMPOSE_PROFILES \
  COMPOSE_PROJECT_NAME
DOCKER_HOST=unix:///run/docker.sock
export DOCKER_HOST

app_root="${OMEGA_GCP_APP_ROOT:-/opt/modecissions}"
shared_root="${app_root}/shared"
operation_marker="${shared_root}/operation-state.json"
state_link="${OMEGA_GCP_STATE_LINK_OVERRIDE:-${shared_root}/runtime-state}"
mode="${1:-verify}"
if [ "$mode" = "authorize-start" ] && [ "${OMEGA_GCP_RUNTIME_START_AUTHORIZED:-0}" != "1" ]; then
  echo "omega: volatile runtime-start authorization is missing; Docker remains fenced" >&2
  exit 74
fi

if [ -L "$operation_marker" ]; then echo "omega: durable operation marker is a link; Docker remains fenced" >&2; exit 75; fi
if [ -e "$operation_marker" ] && [ "${OMEGA_GCP_ALLOW_OPERATION_MARKER:-0}" != "1" ]; then
  echo "omega: durable canonical operation is incomplete; Docker remains fenced" >&2; exit 75
fi
if [ -e "$operation_marker" ] && [ "${OMEGA_GCP_ALLOW_OPERATION_MARKER:-0}" = "1" ]; then
  watchdog="${OMEGA_GCP_OPERATION_WATCHDOG:-/usr/local/sbin/omega-operation-watchdog}"
  timeout_bin="${OMEGA_GCP_TIMEOUT:-/usr/bin/timeout}"
  if [ "$(id -u)" = "0" ]; then
    if [ "$watchdog" != /usr/local/sbin/omega-operation-watchdog ] || \
       [ "$timeout_bin" != /usr/bin/timeout ]; then
      echo "omega: operation watchdog path is unconfined; Docker remains fenced" >&2
      exit 75
    fi
  fi
  if [ ! -x "$watchdog" ] || [ ! -x "$timeout_bin" ] || \
      ! "$timeout_bin" --signal=TERM --kill-after=2s 15s \
        "$watchdog" marker-check 0 \
        "$operation_marker"; then
    echo "omega: durable operation marker contract differs; Docker remains fenced" >&2
    exit 75
  fi
fi

safe_io="${OMEGA_GCP_SAFE_IO:-/usr/local/sbin/omega-safe-io}"
if [ "$(id -u)" = "0" ]; then
  case "$safe_io" in
    /usr/local/sbin/omega-safe-io|/run/omega-gcp-bootstrap.*/safe_io.py) ;;
    *) echo "omega: safe I/O helper path is unconfined; Docker remains fenced" >&2; exit 76 ;;
  esac
fi
if [ ! -x "$safe_io" ]; then
  echo "omega: safe I/O helper is missing; Docker remains fenced" >&2
  exit 76
fi
exec "$safe_io" operation-gate --app-root "$app_root" \
  --state-link "$state_link" --operation-marker "$operation_marker" \
  --mode "$mode"

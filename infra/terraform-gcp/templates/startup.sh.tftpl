#!/usr/bin/env bash
set -Eeuo pipefail
set +x
umask 077

# No Terraform value is interpolated as shell syntax. The only data boundary is
# one base64 JSON document validated by omega-safe-io before any scalar is used.
STARTUP_CONFIG_BASE64='${startup_config_base64}'
RUNTIME_BASE64='${bootstrap_runtime_base64}'
SAFE_IO_BASE64='${safe_io_base64}'
METADATA_FIREWALL_BASE64='${metadata_firewall_base64}'
OPERATION_GUARD_BASE64='${operation_guard_base64}'
RUNTIME_ROOT="$(mktemp -d /run/omega-gcp-bootstrap.XXXXXX)"

cleanup() {
  status=$?
  trap - EXIT
  case "$RUNTIME_ROOT" in
    /run/omega-gcp-bootstrap.*) rm -rf -- "$RUNTIME_ROOT" ;;
    *) status=70 ;;
  esac
  exit "$status"
}
trap cleanup EXIT

# Fence Docker before decoding configuration or running the bootstrap engine.
systemctl stop docker.service docker.socket containerd.service >/dev/null 2>&1 || true
systemctl mask --runtime docker.service docker.socket containerd.service >/dev/null 2>&1 || true

printf '%s' "$RUNTIME_BASE64" | base64 -d > "$RUNTIME_ROOT/bootstrap-runtime.sh"
printf '%s' "$SAFE_IO_BASE64" | base64 -d > "$RUNTIME_ROOT/safe_io.py"
printf '%s' "$METADATA_FIREWALL_BASE64" | base64 -d > "$RUNTIME_ROOT/metadata-firewall.sh"
printf '%s' "$OPERATION_GUARD_BASE64" | base64 -d > "$RUNTIME_ROOT/omega-operation-gate"
chmod 0700 "$RUNTIME_ROOT/bootstrap-runtime.sh" "$RUNTIME_ROOT/safe_io.py" \
  "$RUNTIME_ROOT/metadata-firewall.sh" "$RUNTIME_ROOT/omega-operation-gate"

export OMEGA_GCP_STARTUP_CONFIG_BASE64="$STARTUP_CONFIG_BASE64"
export OMEGA_GCP_SAFE_IO_SOURCE="$RUNTIME_ROOT/safe_io.py"
export OMEGA_GCP_METADATA_FIREWALL_SOURCE="$RUNTIME_ROOT/metadata-firewall.sh"
export OMEGA_GCP_OPERATION_GUARD_SOURCE="$RUNTIME_ROOT/omega-operation-gate"
"$RUNTIME_ROOT/bootstrap-runtime.sh"

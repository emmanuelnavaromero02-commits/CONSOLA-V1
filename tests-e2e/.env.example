# v1.44.3.2.1 — Deep-coverage E2E credentials.
#
# Copy to .env (gitignored). The suite reads these at runtime
# via process.env; no defaults are hard-coded in the spec files.
#
# Codex's diagnostic confirmed that the real local-dev admin is
# emmanuel@local.ai with password omega2026 — the user EXISTS in
# the bootstrap users table. Do NOT replace with a different
# operator until the deep tests have been wired against this one;
# several specs assert on the email substring in the rendered UI.

TEST_EMAIL=emmanuel@local.ai
TEST_PASSWORD=omega2026

# Public origins the tests target
BASE_URL=http://localhost:3000           # Next.js console (v1.44.x)
LEGACY_URL=http://localhost:8000         # FastAPI console (HTML pages + APIs)
BACKEND_URL=http://localhost:8000        # Alias used by fixtures/auth.ts

# v1.44.3.3 Task A — disable the /auth/* rate limiter for E2E
# runs. The Next.js same-origin proxy collapses every E2E
# request into one source-IP from FastAPI's view, so concurrent
# logins blow through the 8/300s window before the suite
# finishes. Export this in your shell before ``make up`` so the
# FastAPI console service picks it up via docker-compose.
#
# Production deployments leave the var unset and the limiter
# stays on (see _rate_limit_disabled in console/app/main.py).
RATE_LIMIT_ENABLED=false

# v1.44.3.2.1 — discovered login flow:
#   POST /auth/login (NOT /api/auth/login)
#   Prerequisites: GET /login first to seed csrf_token cookie,
#   then echo it as X-CSRF-Token + Cookie on the POST.
# fixtures/auth.ts handles all of this; the URLs above are the
# only knobs operators need to flip.

# External service URLs
AIRFLOW_URL=http://localhost:8082        # Local compose uses :8082, NOT :8080
SUPERSET_URL=http://localhost:8088
MINIO_CONSOLE_URL=http://localhost:9001
MAILHOG_URL=http://localhost:8025
MAILHOG_API_URL=http://localhost:8025/api

# Cartridge MCP endpoints
REPLICON_URL=http://localhost:8201
SAP_HCM_URL=http://localhost:8202
SAP_SF_URL=http://localhost:8203
SAP_S4_URL=http://localhost:8204

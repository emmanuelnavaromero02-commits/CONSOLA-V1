# v1.44.3.2 — OMEGA E2E test credentials.
#
# Copy to .env (which is gitignored) and fill with REAL local-dev
# credentials. The suite reads these at runtime via process.env;
# no defaults are hard-coded in the spec files.
#
# Codex's diagnostic surfaced that the real local-dev admin is
# emmanuel@local.ai (NOT the historical admin@omega.local) — make
# sure the .env reflects whatever user actually exists in your
# bootstrap_admin run.

# Console login credentials (must exist in users table)
TEST_EMAIL=emmanuel@local.ai
TEST_PASSWORD=ChangeMeFirstBoot123!

# Public origins the tests target
BASE_URL=http://localhost:3000           # Next.js console (v1.44.x)
LEGACY_URL=http://localhost:8000         # FastAPI console (HTML pages + APIs)

# External service URLs (used by 08-external-services.spec.ts).
# Codex's diagnostic confirmed Airflow runs on :8082 locally
# (NOT the 8080 the legacy docs sometimes quote) — adjust if your
# compose override moves it.
AIRFLOW_URL=http://localhost:8082
SUPERSET_URL=http://localhost:8088
MINIO_CONSOLE_URL=http://localhost:9001
MAILHOG_URL=http://localhost:8025

# Cartridge MCP endpoints (each replies on its own port; the
# external-services spec just probes /healthz which is unauthenticated).
REPLICON_URL=http://localhost:8201
SAP_HCM_URL=http://localhost:8202
SAP_SF_URL=http://localhost:8203
SAP_S4_URL=http://localhost:8204
